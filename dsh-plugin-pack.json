{
  "schemaVersion": 1,
  "id": "dsh-plugin-pack-web",
  "name": "DSH Web 插件包",
  "version": "1.1.0",
  "description": "用于 DSH profile/web 插件环境的结构化安装清单。官方内置插件不重复收录。",
  "license": "MIT",
  "plugins": [
    {
      "id": "dsh-session-context-menu",
      "name": "DSH 会话右键菜单",
      "kind": "plugin",
      "spec": "github:baihejiangnan/dsh-session-context-menu",
      "repository": "https://github.com/baihejiangnan/dsh-session-context-menu"
    },
    {
      "id": "zat-dsh-engine",
      "name": "ZAT DSH 引擎",
      "kind": "plugin",
      "spec": "github:mishibeikejie/zat-dsh-engine",
      "repository": "https://github.com/mishibeikejie/zat-dsh-engine"
    },
    {
      "id": "modlens",
      "name": "ModLens 模块透镜",
      "kind": "plugin",
      "spec": "@liustack/modlens"
    },
    {
      "id": "billion-context-dsh",
      "name": "Billion Context 上下文",
      "kind": "plugin",
      "spec": "billion-context-dsh"
    },
    {
      "id": "dsh-better-sidebar",
      "name": "DSH 更好侧边栏",
      "kind": "plugin",
      "spec": "dsh-better-sidebar",
      "repository": "https://github.com/omdsh-dev/DSH-better-sidebar"
    },
    {
      "id": "dsh-sidebar-qa",
      "name": "DSH 侧边栏追问",
      "kind": "extension",
      "spec": "dsh-sidebar-qa",
      "repository": "https://github.com/ChenRuoT/dsh-sidebar-qa",
      "description": "通过 Better Sidebar 注册追问与追问记录页面的第三方扩展。",
      "requires": ["dsh-better-sidebar"]
    },
    {
      "id": "dsh-checkpoint-rewind",
      "name": "DSH 检查点回退",
      "kind": "plugin",
      "spec": "dsh-checkpoint-rewind"
    },
    {
      "id": "dsh-checkpoint-diff",
      "name": "DSH 检查点差异",
      "kind": "plugin",
      "spec": "dsh-checkpoint-diff"
    },
    {
      "id": "dsh-extension-hub",
      "name": "DSH 扩展中心",
      "kind": "plugin",
      "spec": "dsh-extension-hub"
    },
    {
      "id": "dsh-tdai-memory",
      "name": "DSH TDAI 记忆",
      "kind": "plugin",
      "spec": "dsh-tdai-memory"
    },
    {
      "id": "dsh-web-mobile-fix",
      "name": "DSH Web 移动端修复",
      "kind": "plugin",
      "spec": "dsh-web-mobile-fix"
    },
    {
      "id": "dsh-what-changed",
      "name": "DSH 变更记录",
      "kind": "plugin",
      "spec": "dsh-what-changed"
    },
    {
      "id": "dsh-navbar",
      "name": "DSH 导航栏",
      "kind": "plugin",
      "spec": "github:vlln/dsh-navbar",
      "repository": "https://github.com/vlln/dsh-navbar"
    },
    {
      "id": "dsh-balance-tide",
      "name": "DSH Balance Tide 平衡潮汐",
      "kind": "plugin",
      "spec": "github:huanyuLv/dsh-balance-tide",
      "repository": "https://github.com/huanyuLv/dsh-balance-tide"
    },
    {
      "id": "dsh-offpeak",
      "name": "DSH OffPeak 非高峰",
      "kind": "plugin",
      "spec": "github:christophersmith2737-commits/OffPeak",
      "repository": "https://github.com/christophersmith2737-commits/OffPeak"
    },
    {
      "id": "dsh-session-manager",
      "name": "DSH 会话管理器",
      "kind": "plugin",
      "spec": "github:dream12347/dsh-session-manager",
      "repository": "https://github.com/dream12347/dsh-session-manager"
    },
    {
      "id": "dsh-undo-savepoint",
      "name": "DSH 撤销保存点",
      "kind": "plugin",
      "spec": "github:lire1131/dsh-undo-plugin",
      "repository": "https://github.com/lire1131/dsh-undo-plugin"
    },
    {
      "id": "dsh-topbar-manager",
      "name": "DSH 顶栏管理器",
      "kind": "plugin",
      "spec": "github:baihejiangnan/dsh-topbar-manager",
      "repository": "https://github.com/baihejiangnan/dsh-topbar-manager"
    },
    {
      "id": "dsh-side-session",
      "name": "DSH 侧栏会话",
      "kind": "plugin",
      "spec": "github:hzhz314159/dsh-side-session",
      "repository": "https://github.com/hzhz314159/dsh-side-session"
    },
    {
      "id": "dsh-at-file",
      "name": "DSH @ 文件",
      "kind": "plugin",
      "spec": "https://github.com/omdsh-dev/dsh-at-file/archive/refs/tags/v0.6.3.tar.gz",
      "repository": "https://github.com/omdsh-dev/dsh-at-file"
    },
    {
      "id": "dsh-genui",
      "name": "DSH GenUI 界面生成",
      "kind": "plugin",
      "spec": "github:omdsh-dev/dsh-genui",
      "repository": "https://github.com/omdsh-dev/dsh-genui"
    },
    {
      "id": "dsh-automation",
      "name": "DSH 自动化",
      "kind": "plugin",
      "spec": "github:titanwings/dsh-automation",
      "repository": "https://github.com/titanwings/dsh-automation"
    },
    {
      "id": "dsh-notification",
      "name": "DSH 通知",
      "kind": "plugin",
      "spec": "github:omdsh-dev/dsh-notification",
      "repository": "https://github.com/omdsh-dev/dsh-notification"
    },
    {
      "id": "dsh-status-rotator",
      "name": "DSH 状态轮换",
      "kind": "plugin",
      "spec": "dsh-status-rotator"
    },
    {
      "id": "dsh-auto-collapse",
      "name": "DSH 自动折叠",
      "kind": "plugin",
      "spec": "github:a179-sanae/dsh-auto-collapse#main",
      "repository": "https://github.com/a179-sanae/dsh-auto-collapse"
    },
    {
      "id": "dsh-plugin-guard",
      "name": "DSH 插件守卫",
      "kind": "plugin",
      "spec": "github:lxzy-7/dsh-plugin-guard",
      "repository": "https://github.com/lxzy-7/dsh-plugin-guard"
    },
    {
      "id": "dsh-web-plugin-manager",
      "name": "DSH Web 插件管理器",
      "kind": "plugin",
      "spec": "github:LX2000WASD/dsh-web-plugin-manager",
      "repository": "https://github.com/LX2000WASD/dsh-web-plugin-manager"
    },
    {
      "id": "dsh-plugin-healthcheck",
      "name": "DSH 插件健康检查",
      "kind": "plugin",
      "spec": "github:chenw2759-wq/dsh-plugin-healthcheck",
      "repository": "https://github.com/chenw2759-wq/dsh-plugin-healthcheck"
    },
    {
      "id": "dsh-settings-organizer",
      "name": "DSH 设置整理器",
      "kind": "plugin",
      "spec": "https://codeload.github.com/baihejiangnan/dsh-settings-organizer/tar.gz/refs/tags/v1.1.0",
      "repository": "https://github.com/baihejiangnan/dsh-settings-organizer"
    },
    {
      "id": "dsh-skin",
      "name": "DSH 皮肤",
      "kind": "plugin",
      "spec": "github:wei-806206088/dsh-skin",
      "repository": "https://github.com/wei-806206088/dsh-skin"
    }
  ]
}
